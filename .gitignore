# datasets are large and reproducible; keep the folder, not the contents
dataset/*
datasets/*
!dataset/.gitkeep
!datasets/.gitkeep
data/

# secrets
.env
.env.*
!.env.example

# environments and dependencies
.venv/
venv/
node_modules/
__pycache__/
.pytest_cache/

# build output
dist/
test-results/

